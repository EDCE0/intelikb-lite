# DeepSeek 配置（必填）
DEEPSEEK_API_KEY=sk-你的密钥
# 可选：接口地址，默认 https://api.deepseek.com
DEEPSEEK_API_BASE=https://api.deepseek.com
# 可选：deepseek-chat（默认）或 deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
# 可选：生成参数
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=2048

# 向量化：DeepSeek 无 embedding 接口，使用本地 BGE 中文模型
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DEVICE=cpu
# EMBED_BATCH_SIZE=16

# 向量库与知识库
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=intelikb
DATA_DIR=data/raw

# 回答模式：strict 只用资料 / hybrid 资料优先+模型补充（默认）/ general 纯模型知识
ANSWER_MODE=hybrid

# 检索与分块
SIMILARITY_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
