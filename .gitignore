# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
myenv/

# 环境变量 / 密钥（.env.example 是模板，需要保留）
.env
.env.*
!.env.example

# 向量库：运行后生成，体积大，不入库
chroma_db/
*.sqlite3

# 知识库原始文献：涉及版权且体积大，不随仓库发布
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep

# 运行产物
outputs/*
!outputs/.gitkeep
*.log
pip_*.log

# Jupyter / 编辑器 / 系统文件
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.idea/
.vscode/
